<?xml version="1.0" encoding="utf-8"?>
<!-- Pressing pushes a button into its shadow (see Brutal.button) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:duration="100" android:propertyName="translationX" android:valueTo="4dp" android:valueType="floatType" />
            <objectAnimator android:duration="100" android:propertyName="translationY" android:valueTo="4dp" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="120" android:propertyName="translationX" android:valueTo="0dp" android:valueType="floatType" />
            <objectAnimator android:duration="120" android:propertyName="translationY" android:valueTo="0dp" android:valueType="floatType" />
        </set>
    </item>
</selector>
