<?xml version="1.0" encoding="utf-8"?>
<!-- As on the website: hovering (controller ray or hand) lifts a button off its shadow, pressing pushes it into the
     shadow (see Brutal.button). Ease-out, short. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:duration="100" android:interpolator="@android:interpolator/decelerate_cubic" android:propertyName="translationX" android:valueTo="4dp" android:valueType="floatType" />
            <objectAnimator android:duration="100" android:interpolator="@android:interpolator/decelerate_cubic" android:propertyName="translationY" android:valueTo="4dp" android:valueType="floatType" />
        </set>
    </item>
    <item android:state_hovered="true">
        <set>
            <objectAnimator android:duration="140" android:interpolator="@android:interpolator/decelerate_cubic" android:propertyName="translationX" android:valueTo="-2dp" android:valueType="floatType" />
            <objectAnimator android:duration="140" android:interpolator="@android:interpolator/decelerate_cubic" android:propertyName="translationY" android:valueTo="-2dp" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="140" android:interpolator="@android:interpolator/decelerate_cubic" android:propertyName="translationX" android:valueTo="0dp" android:valueType="floatType" />
            <objectAnimator android:duration="140" android:interpolator="@android:interpolator/decelerate_cubic" android:propertyName="translationY" android:valueTo="0dp" android:valueType="floatType" />
        </set>
    </item>
</selector>
