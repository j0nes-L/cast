# Copy to .env for local development. On Vercel, set the same variables in the project settings.

# LiveKit. These values match server/livekit-dev.ps1.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# Hash of the viewer password, never the password itself: npm run hash-password -- "<password>"
VIEWER_PASSWORD_HASH=

# Paired headsets are stored in Upstash Redis (Vercel Marketplace sets these two).
# Without them, development uses the local file .data/store.json.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional static devices, e.g. for the test publisher: JSON array of { deviceId, secretSha256 } in single quotes.
# npm run new-device -- <deviceId>
DEVICES='[]'

# This instance (not secret). The privacy page names the operator and the streaming server's host.
OPERATOR_NAME=
OPERATOR_EMAIL=
# OPERATOR_URL=https://example.org/
# LEGAL_URL=https://example.org/legal
SERVER_PROVIDER=
SERVER_COUNTRY=DE
# SIGNALLING_VIA_CLOUDFLARE=true
