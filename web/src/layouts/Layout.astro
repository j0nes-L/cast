---
// Shared page frame: font, side bar, footer and the language (see lib/i18n.ts).
import '@fontsource-variable/space-grotesk';
import '../styles/cast.css';
import { CircleUser, Scale, ShieldCheck } from '@lucide/astro';
import { LEGAL_URL, OPERATOR_NAME, OPERATOR_URL } from 'astro:env/server';
import Sidebar from '../components/Sidebar.astro';
import { en_, label, strings, type Key } from '../lib/i18n';

interface Props {
  title: Key;
  current?: 'live' | 'headsets' | 'privacy';
}
const { title, current } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title data-t={title}>{en_(title)}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Before the page shows, so that the right language and the matching privacy text appear at once
      let saved = null;
      try {
        saved = localStorage.getItem('cast.lang');
      } catch {}
      document.documentElement.lang =
        saved === 'de' || saved === 'en' ? saved : navigator.language.toLowerCase().startsWith('de') ? 'de' : 'en';
    </script>
  </head>
  <body>
    <Sidebar current={current} />
    <div class="frame">
      <slot />
      <footer class="site-footer">
        <a class="icon-link" href="/privacy" {...label('footer.privacy')}><ShieldCheck stroke-width={2} /></a>
        {LEGAL_URL && <a class="icon-link" href={LEGAL_URL} {...label('footer.legal')}><Scale stroke-width={2} /></a>}
        {
          OPERATOR_URL ? (
            <a class="icon-link" href={OPERATOR_URL} aria-label={OPERATOR_NAME} title={OPERATOR_NAME}>
              <CircleUser stroke-width={2} />
            </a>
          ) : (
            <span class="operator">{OPERATOR_NAME}</span>
          )
        }
        <a class="icon-link" href="https://github.com/j0nes-L/cast" target="_blank" rel="noopener noreferrer" {...label('footer.source')}>
          <!-- GitHub mark (Primer Octicons, MIT); Lucide has no brand icons -->
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M10.226 17.284c-2.965-.36-5.054-2.493-5.054-5.256 0-1.123.404-2.336 1.078-3.144-.292-.741-.247-2.314.09-2.965.898-.112 2.111.36 2.83 1.01.853-.269 1.752-.404 2.853-.404 1.1 0 1.999.135 2.807.382.696-.629 1.932-1.1 2.83-.988.315.606.36 2.179.067 2.942.72.854 1.101 2 1.101 3.167 0 2.763-2.089 4.852-5.098 5.234.763.494 1.28 1.572 1.28 2.807v2.336c0 .674.561 1.056 1.235.786 4.066-1.55 7.255-5.615 7.255-10.646C23.5 6.188 18.334 1 11.978 1 5.62 1 .5 6.188.5 12.545c0 4.986 3.167 9.12 7.435 10.669.606.225 1.19-.18 1.19-.786V20.63a2.9 2.9 0 0 1-1.078.224c-1.483 0-2.359-.808-2.987-2.313-.247-.607-.517-.966-1.034-1.033-.27-.023-.359-.135-.359-.27 0-.27.45-.471.898-.471.652 0 1.213.404 1.797 1.235.45.651.921.943 1.483.943.561 0 .92-.202 1.437-.719.382-.381.674-.718.944-.943" /></svg>
        </a>
      </footer>
    </div>

    <script is:inline define:vars={{ strings }}>
      // Swaps in the texts of the chosen language: before the first paint, and again on every switch, without a reload.
      // Every text keeps its key on its element (data-t, data-t-label, data-t-title, with data-t-vars for {placeholders};
      // the page scripts set them through lib/i18n.ts), also inside <template>s.
      const html = document.documentElement;
      const apply = (root, dict) => {
        const text = (el, key) => {
          const vars = JSON.parse(el.dataset.tVars || '{}');
          return dict[key]?.replace(/\{(\w+)\}/g, (_, name) => vars[name] ?? '');
        };
        root.querySelectorAll('[data-t]').forEach((el) => {
          const s = text(el, el.dataset.t);
          if (s) el.textContent = s;
        });
        root.querySelectorAll('[data-t-label]').forEach((el) => {
          const s = text(el, el.dataset.tLabel);
          if (s) {
            el.setAttribute('aria-label', s);
            el.title = s;
          }
        });
        root.querySelectorAll('[data-t-title]').forEach((el) => {
          const s = text(el, el.dataset.tTitle);
          if (s) el.title = s;
        });
        root.querySelectorAll('template').forEach((template) => apply(template.content, dict));
      };
      const lang = () => (html.lang === 'de' ? 'de' : 'en');
      apply(document, strings[lang()]);
      document.getElementById('language').onclick = () => {
        html.lang = lang() === 'de' ? 'en' : 'de'; // also swaps the flag and the privacy text (CSS)
        try {
          localStorage.setItem('cast.lang', html.lang);
        } catch {}
        apply(document, strings[html.lang]);
      };
    </script>
  </body>
</html>
