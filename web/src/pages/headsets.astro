---
import Header from '../components/Header.astro';
import SignIn from '../components/SignIn.astro';
import '../styles/cast.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>cast · Headsets</title>
  </head>
  <body>
    <SignIn />

    <div id="content" hidden>
      <Header current="headsets" />
      <main class="page">
        <section class="panel" aria-labelledby="list-title">
          <h2 id="list-title">Headsets</h2>
          <ul id="device-list"></ul>
          <p id="list-message" class="muted" role="status"></p>
          <p class="muted">Headsets are set up once with the setup script (app/setup.ps1). A removed headset shows up again when it casts or is set up again.</p>
        </section>
      </main>
    </div>

    <script>
      import { setupSignIn, viewerFetch, type Session } from '../lib/session';

      type Device = { deviceId: string; name: string; createdAt: string; casting: boolean };

      const content = document.getElementById('content')!;
      const list = document.getElementById('device-list')!;
      const listMessage = document.getElementById('list-message')!;
      let session: Session | null = null;
      let poll = 0;

      async function loadDevices() {
        if (!session) return;
        const res = await viewerFetch(session, '/api/devices').catch(() => null);
        if (!res?.ok) {
          listMessage.textContent = res?.status === 401 ? 'Your sign-in has expired. Reload the page.' : 'Could not load the headsets.';
          return;
        }
        const devices: Device[] = await res.json();
        listMessage.textContent = devices.length ? '' : 'No headset is set up yet.';
        list.replaceChildren(...devices.map(deviceItem));
      }

      function deviceItem(device: Device) {
        const item = document.createElement('li');
        const name = document.createElement('span');
        name.className = 'name';
        name.textContent = device.name;
        const state = document.createElement('span');
        state.className = device.casting ? 'state live' : 'state';
        state.textContent = device.casting ? 'Casting' : `Set up ${new Date(device.createdAt).toLocaleDateString()}`;
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'remove';
        remove.textContent = 'Remove';
        remove.onclick = () => removeDevice(device, remove);
        item.append(name, state, remove);
        return item;
      }

      // Only the list forgets it: the headset keeps its credentials and shows up again when it casts.
      async function removeDevice(device: Device, button: HTMLButtonElement) {
        if (!session || !confirm(`Remove ${device.name} from the list? A running cast ends.`)) return;
        button.disabled = true;
        const res = await viewerFetch(session, '/api/devices/remove', { deviceId: device.deviceId }).catch(() => null);
        if (!res?.ok && res?.status !== 404) {
          button.disabled = false;
          listMessage.textContent = res?.status === 401 ? 'Your sign-in has expired. Reload the page.' : `Could not remove ${device.name}.`;
          return;
        }
        await loadDevices();
      }

      setupSignIn(
        async (newSession) => {
          session = newSession;
          content.hidden = false;
          await loadDevices();
          poll = window.setInterval(loadDevices, 5000);
        },
        () => {
          session = null;
          content.hidden = true;
          clearInterval(poll);
        },
      );
    </script>
  </body>
</html>
