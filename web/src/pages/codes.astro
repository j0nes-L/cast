---
import { ChevronLeft, ChevronRight, Play, Square } from '@lucide/astro';
import { renderSVG } from 'uqr';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
import { en_, label } from '../lib/i18n';

// Held in front of a headset in standby, they start or stop its cast. Not secret, so no sign-in.
const codes = [
  { label: 'codes.start' as const, svg: renderSVG('cast:start', { border: 2 }), Icon: Play },
  { label: 'codes.stop' as const, svg: renderSVG('cast:stop', { border: 2 }), Icon: Square },
];
---

<Layout title="title.codes" current="codes">
  <Header title="title.codes" />
  <main class="codes-page">
    <!-- One code at a time: swipe (touch, touchpad) or the arrows, dots and arrow keys -->
    <div id="slides" class="slides">
      {
        codes.map(({ label, svg, Icon }) => (
          <div class="slide">
            <figure class="card">
              <div class="qr" set:html={svg} />
              <figcaption data-code={label === 'codes.start' ? 'start' : 'stop'}>
                <Icon size={32} stroke-width={2.4} aria-hidden="true" />
                <span class="visually-hidden" data-t={label}>{en_(label)}</span>
              </figcaption>
            </figure>
          </div>
        ))
      }
    </div>
    <div class="slide-controls">
      <button id="previous" type="button" class="icon-button" {...label('codes.previous')}><ChevronLeft /></button>
      <span class="dots">
        {codes.map(({ label: name }, i) => <button type="button" class="dot" data-index={i} aria-current={i === 0 ? 'true' : 'false'} {...label(name)} />)}
      </span>
      <button id="next" type="button" class="icon-button" {...label('codes.next')}><ChevronRight /></button>
    </div>
  </main>

  <script>
    const slides = document.getElementById('slides')!;
    const dots = [...document.querySelectorAll<HTMLButtonElement>('.dot')];
    const current = () => Math.round(slides.scrollLeft / slides.clientWidth);
    // Wraps around, so both arrows always lead to the other code. Keys switch at once: keyboard actions are not animated.
    const show = (index: number, behavior: ScrollBehavior = 'smooth') => {
      const count = dots.length;
      slides.scrollTo({ left: (((index % count) + count) % count) * slides.clientWidth, behavior });
    };

    document.getElementById('previous')!.onclick = () => show(current() - 1);
    document.getElementById('next')!.onclick = () => show(current() + 1);
    dots.forEach((dot, i) => (dot.onclick = () => show(i)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(current() - 1, 'instant');
      if (event.key === 'ArrowRight') show(current() + 1, 'instant');
    });
    slides.addEventListener('scroll', () => dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === current()))), {
      passive: true,
    });
  </script>
</Layout>
