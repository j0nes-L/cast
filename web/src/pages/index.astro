---
import { Cast, CircleStop, Focus, LayoutGrid, Maximize, Minimize, Volume2, VolumeX } from '@lucide/astro';
import Header from '../components/Header.astro';
import SignIn from '../components/SignIn.astro';
import Layout from '../layouts/Layout.astro';
import { en_, label } from '../lib/i18n';
---

<Layout title="title.live" current="live">
    <SignIn />

    <main id="live" hidden>
      <Header title="title.live" />
      <section id="empty" class="card empty">
        <span class="mark" aria-hidden="true"><Cast size={36} stroke-width={2} /></span>
        <p class="empty-title" data-t="live.empty">{en_('live.empty')}</p>
        <p class="muted" data-t="live.emptyHint">{en_('live.emptyHint')}</p>
      </section>
      <div id="tiles"></div>
    </main>

    <!-- Toggle buttons hold both icons; the CSS shows the one for the current state (aria-pressed, fullscreen) -->
    <template id="tile-template">
      <article class="tile">
        <div class="screen">
          <video autoplay playsinline muted></video>
          <span class="spinner on-dark" aria-hidden="true"></span>
        </div>
        <footer>
          <span class="name"></span>
          <span class="quality status-dot" role="img"></span>
          <span class="actions">
            <button type="button" class="icon-button mute" aria-pressed="false" {...label('live.mute')}>
              <Volume2 class="when-off" /><VolumeX class="when-on" />
            </button>
            <button type="button" class="icon-button fullscreen" {...label('live.fullscreen')}>
              <Maximize class="when-off" /><Minimize class="when-on" />
            </button>
            <button type="button" class="icon-button focus" aria-pressed="false" {...label('live.focus')}>
              <Focus class="when-off" /><LayoutGrid class="when-on" />
            </button>
            <button type="button" class="icon-button danger end" {...label('live.end')}><CircleStop /></button>
          </span>
        </footer>
      </article>
    </template>

    <script>
      import { DisconnectReason, Room, RoomEvent, Track, type RemoteParticipant } from 'livekit-client';
      import { busy, setLabel, setText, t, Translated, type Key } from '../lib/i18n';
      import { setupSignIn, viewerFetch, type Session } from '../lib/session';

      const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const live = byId('live');
      const statusText = byId('status');
      const empty = byId('empty');
      const tilesEl = byId('tiles');
      const template = byId<HTMLTemplateElement>('tile-template');

      type Tile = {
        el: HTMLElement;
        participant: RemoteParticipant;
        video: HTMLVideoElement;
        quality: HTMLElement;
        focus: HTMLButtonElement;
        mute: HTMLButtonElement;
        fullscreen: HTMLButtonElement;
        end: HTMLButtonElement;
      };

      const QUALITY: Record<string, Key> = {
        excellent: 'quality.excellent',
        good: 'quality.good',
        poor: 'quality.poor',
        lost: 'quality.lost',
      };
      const LEVEL: Record<string, string> = { excellent: 'ok', good: 'ok', poor: 'warn', lost: 'bad' };
      // Status line in the page head: a colored circle and the message
      const setStatus = (key: Key | null, vars = {}, level = 'bad') => {
        setText(statusText, key, vars);
        statusText.dataset.level = level;
      };
      const tiles = new Map<string, Tile>();
      let manualFocus: string | null = null;
      let muted = false;
      let mutedFor: string | null = null; // the focus the mute applies to; a new focus starts unmuted
      let session: Session | null = null;

      const room = new Room({ adaptiveStream: true, dynacast: true });

      // A single tile is focused automatically.
      function focused(): string | null {
        if (manualFocus && tiles.has(manualFocus)) return manualFocus;
        return tiles.size === 1 ? [...tiles.keys()][0] : null;
      }

      // Tile size as in Discord: the column count that gives the largest 16:9 tiles in the free area; the last row is
      // centered (CSS). With a focused tile it takes the area and the others shrink to a strip below it.
      const GAP = 24; // 1.5rem, the gap in #tiles
      const BAR = 66; // tile footer under the video
      const THUMB = 220 * (9 / 16) + BAR + GAP; // a strip of small tiles
      const MIN = 300; // below this the tiles may not shrink to fit the height: the page scrolls instead (phones)
      function layout() {
        const width = tilesEl.clientWidth;
        // Free height: below the tiles come the footer and the frame's padding (room for the side bar on phones)
        const footer = document.querySelector<HTMLElement>('.site-footer')!;
        const below = footer.offsetHeight + parseFloat(getComputedStyle(footer.parentElement!).paddingBottom);
        const height = Math.max(240, innerHeight - tilesEl.getBoundingClientRect().top - below);
        const toWidth = (h: number) => ((h - BAR) * 16) / 9;
        let best = 0;
        if (focused()) {
          best = Math.min(width, toWidth(height - (tiles.size > 1 ? THUMB : 0)));
        } else {
          for (let cols = 1; cols <= tiles.size; cols++) {
            const rows = Math.ceil(tiles.size / cols);
            best = Math.max(best, Math.min((width - GAP * (cols - 1)) / cols, toWidth((height - GAP * (rows - 1)) / rows)));
          }
        }
        if (best < Math.min(MIN, width)) {
          const cols = Math.max(1, Math.floor((width + GAP) / (MIN + GAP)));
          best = (width - GAP * (cols - 1)) / cols;
        }
        tilesEl.style.setProperty('--tile-w', `${Math.floor(best)}px`);
        tilesEl.style.setProperty('--stage-h', `${Math.floor(height)}px`); // centers the grid in the free area
      }
      new ResizeObserver(layout).observe(tilesEl);

      // Applies focus and audio rules: only the focused tile is large and audible.
      function render() {
        const focus = focused();
        if (focus !== mutedFor) {
          mutedFor = focus;
          muted = false;
        }
        live.classList.toggle('has-focus', focus !== null);
        empty.hidden = tiles.size > 0;
        for (const [identity, tile] of tiles) {
          const isFocus = identity === focus;
          tile.el.classList.toggle('focused', isFocus);
          tile.el.classList.toggle('thumb', focus !== null && !isFocus);
          tile.focus.hidden = tiles.size === 1;
          setLabel(tile.focus, isFocus ? 'live.showAll' : 'live.focus');
          tile.focus.setAttribute('aria-pressed', String(isFocus));
          tile.mute.hidden = !isFocus;
          // Browsers block sound until the page was clicked, e.g. after a reload with a remembered sign-in: then the
          // sound button shows "off", nudges and turns the sound on
          const blocked = !muted && !room.canPlaybackAudio;
          tile.mute.classList.toggle('blocked', blocked);
          tile.fullscreen.hidden = !isFocus;
          setLabel(tile.mute, blocked ? 'live.enableAudio' : muted ? 'live.unmute' : 'live.mute');
          tile.mute.setAttribute('aria-pressed', String(muted || blocked));
          for (const pub of tile.participant.audioTrackPublications.values()) pub.setSubscribed(isFocus && !muted);
        }
        layout();
      }

      function addTile(participant: RemoteParticipant) {
        const identity = participant.identity;
        if (!identity.startsWith('device-') || tiles.has(identity)) return;
        const el = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
        const part = <T extends Element>(selector: string) => el.querySelector(selector) as T;
        const tile: Tile = {
          el,
          participant,
          video: part('video'),
          quality: part('.quality'),
          focus: part('.focus'),
          mute: part('.mute'),
          fullscreen: part('.fullscreen'),
          end: part('.end'),
        };
        const deviceId = identity.slice('device-'.length);
        const name = participant.name || deviceId;
        part('.name').textContent = name;
        part<HTMLElement>('.name').title = name; // the full name when it is shortened
        tile.end.onclick = () => endCast(deviceId, name, tile.end);
        tile.focus.onclick = () => {
          manualFocus = focused() === identity ? null : identity;
          render();
        };
        // A small tile in the strip takes the focus when clicked, as in Discord
        el.addEventListener('click', (event) => {
          if (!el.classList.contains('thumb') || (event.target as Element).closest('button')) return;
          manualFocus = identity;
          render();
        });
        tile.mute.onclick = () => {
          if (room.canPlaybackAudio) muted = !muted;
          else {
            muted = false;
            room.startAudio(); // allowed now: this is a click on the page
          }
          render();
        };
        tile.fullscreen.onclick = () => {
          if (document.fullscreenElement) return void document.exitFullscreen();
          // Holds the focus, and with it the sound and the buttons, when another headset starts casting
          manualFocus = identity;
          el.requestFullscreen();
        };
        // Loading circle until the picture runs, and again while it stalls
        tile.video.addEventListener('playing', () => el.classList.add('playing'));
        tile.video.addEventListener('waiting', () => el.classList.remove('playing'));
        tiles.set(identity, tile);
        tilesEl.append(el);
        for (const pub of participant.videoTrackPublications.values()) pub.setSubscribed(true);
        showQuality(participant);
      }

      function removeTile(participant: RemoteParticipant) {
        tiles.get(participant.identity)?.el.remove();
        tiles.delete(participant.identity);
        if (manualFocus === participant.identity) manualFocus = null;
      }

      function showQuality(participant: RemoteParticipant) {
        const tile = tiles.get(participant.identity);
        if (!tile) return;
        const key = QUALITY[participant.connectionQuality];
        // A colored circle; the words are its tooltip and accessible name
        tile.quality.hidden = !key;
        if (key) setLabel(tile.quality, key);
        tile.quality.dataset.level = LEVEL[participant.connectionQuality] ?? '';
      }

      room
        .on(RoomEvent.ParticipantConnected, (p) => {
          addTile(p);
          render();
        })
        .on(RoomEvent.ParticipantDisconnected, (p) => {
          removeTile(p);
          render();
        })
        .on(RoomEvent.TrackPublished, (pub) => {
          if (pub.kind === Track.Kind.Video) pub.setSubscribed(true);
          else render();
        })
        .on(RoomEvent.TrackSubscribed, (track, pub, p) => {
          const tile = tiles.get(p.identity);
          if (!tile) return;
          if (track.kind === Track.Kind.Video) return void track.attach(tile.video);
          const audio = track.attach();
          audio.dataset.sid = pub.trackSid;
          tile.el.append(audio);
        })
        .on(RoomEvent.TrackUnsubscribed, (track, pub) => {
          track.detach();
          // livekit-client may already have detached the element, so find it by track id
          document.querySelectorAll(`audio[data-sid="${pub.trackSid}"]`).forEach((e) => e.remove());
        })
        .on(RoomEvent.ConnectionQualityChanged, (_quality, p) => showQuality(p as RemoteParticipant))
        .on(RoomEvent.AudioPlaybackStatusChanged, render)
        .on(RoomEvent.Reconnecting, () => setStatus('live.reconnecting', {}, 'warn'))
        .on(RoomEvent.Reconnected, () => setStatus(null))
        .on(RoomEvent.Disconnected, (reason) => {
          // Our own disconnect: sign-out handles it, and when leaving the page the next page takes over
          if (reason === DisconnectReason.CLIENT_INITIATED) return;
          hideLive();
          signInUi.showSignIn(new Translated('error.connectionClosed'));
        });

      function hideLive() {
        for (const tile of tiles.values()) removeTile(tile.participant);
        live.hidden = true;
        session = null;
      }


      // The headset leaves the room; its tile disappears with the ParticipantDisconnected event.
      async function endCast(deviceId: string, name: string, button: HTMLButtonElement) {
        if (!session || !confirm(t('live.endConfirm', { name }))) return;
        const current = session;
        const res = await busy(button, () => viewerFetch(current, '/api/cast/stop', { deviceId }).catch(() => null));
        if (res?.ok) return;
        setStatus(res?.status === 401 ? 'error.expired' : 'live.endFailed', { name });
      }

      const signInUi = setupSignIn(
        async (newSession) => {
          await room.connect(newSession.url, newSession.token, { autoSubscribe: false }).catch(() => {
            throw new Translated('error.streamingUnreachable');
          });
          session = newSession;
          live.hidden = false;
          for (const p of room.remoteParticipants.values()) addTile(p);
          render();
        },
        () => {
          room.disconnect();
          hideLive();
        },
      );
    </script>
</Layout>
