---
// Page title; #status shows connection messages with a colored circle (data-level: ok, warn, bad).
import { en_, type Key } from '../lib/i18n';

interface Props {
  title: Key;
}
const { title } = Astro.props;
---

<header class="page-head">
  <div class="page-title">
    <a class="eyebrow" href="/">Cast</a>
    <h1 data-t={title}>{en_(title)}</h1>
  </div>
  <span id="status" class="status" role="status"></span>
  <slot />
</header>
