---
// Page title with the NWDL logo; #status shows connection messages.
import { en_, type Key } from '../lib/i18n';

interface Props {
  title: Key;
}
const { title } = Astro.props;
---

<header class="page-head">
  <a class="brand" href="/"><img src="/nwdl-logo.png" alt="NWDL" width="56" height="56" /></a>
  <div class="page-title">
    <p class="eyebrow">NWDL Cast</p>
    <h1 data-t={title}>{en_(title)}</h1>
  </div>
  <span id="status" role="status"></span>
  <slot />
</header>
