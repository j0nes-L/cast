---
import { ArrowRight, Cast, Lock } from '@lucide/astro';
import { en_, label } from '../lib/i18n';
---

<!-- Shown while the page resumes the sign-in and loads; lib/session.ts hides it -->
<div id="page-loading" class="page-loading" role="status">
  <span class="spinner" aria-hidden="true"></span>
  <span class="visually-hidden" data-t="common.loading">{en_('common.loading')}</span>
</div>

<form id="login" class="sign-in card" hidden>
  <div class="sign-in-title">
    <span class="mark" aria-hidden="true"><Cast size={28} stroke-width={2.2} /></span>
    <h1>Cast</h1>
  </div>
  <!-- lets password managers save and fill the password -->
  <input type="text" name="username" autocomplete="username" value="cast" hidden />
  <label class="visually-hidden" for="password" data-t="signIn.password">{en_('signIn.password')}</label>
  <div class="password-row">
    <span class="field">
      <Lock size={20} stroke-width={2.2} aria-hidden="true" />
      <input id="password" name="password" type="password" autocomplete="current-password" required autofocus />
    </span>
    <button type="submit" class="icon-button primary" {...label('signIn.submit')}><ArrowRight /></button>
  </div>
  <label class="checkbox"><input id="stay-signed-in" type="checkbox" /> <span data-t="signIn.stay">{en_('signIn.stay')}</span></label>
  <p id="login-error" class="error" role="alert"></p>
</form>
